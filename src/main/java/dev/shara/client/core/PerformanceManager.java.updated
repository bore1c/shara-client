package dev.shara.client.core;

import dev.shara.client.SharaClient;

public class PerformanceManager {
    private PerformancePreset current = PerformancePreset.BALANCED;

    public void applyPreset(PerformancePreset preset) {
        this.current = preset;
        switch (preset) {
            case LOW_END -> {
                SharaClient.get().getParticleManager().setMaxParticles(80);
                // Potentially disable advanced renderers
            }
            case BALANCED -> {
                SharaClient.get().getParticleManager().setMaxParticles(400);
            }
            case HIGH_QUALITY -> {
                SharaClient.get().getParticleManager().setMaxParticles(1200);
            }
        }
    }

    public PerformancePreset getCurrent() { return current; }

    public void setReducedMotion(boolean reduced) { SharaClient.get().getAnimationManager().setReducedMotion(reduced); }
}
